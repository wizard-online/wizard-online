{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "editor.formatOnSave": false,
  "files.eol": "\n",
  "editor.tabSize": 2,
  "jest.pathToConfig": "jest.config.quickrun.js",
  "typescript.experimental.useTsgo": true,
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ]
}